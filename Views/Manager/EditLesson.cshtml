@model SwimmingSchool_Implementation.Models.Lesson

@{
    ViewBag.Title = "Edit Lesson";
}

<div class="container py-5">
    <div class="mx-auto bg-white p-4 rounded shadow border" style="max-width: 800px;">

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="text-primary fw-bold mb-0">Edit Lesson</h2>
                <span class="text-muted small">Update details for @Model.Title</span>
            </div>
            <a href="@Url.Action("Lessons", "Manager")" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>

        @using (Html.BeginForm("EditLesson", "Manager", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.AvailablePlaces)

            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger shadow-sm">
                    @Html.ValidationSummary(false, "Please fix the following errors:")
                </div>
            }

            <div class="row g-4">
                <h5 class="fw-bold text-dark mb-0 mt-4">1. Class Details</h5>

                <div class="col-md-8">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(m => m.AgeGroup, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.AgeGroup, new { @class = "form-control" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.LessonType, new { @class = "form-label fw-bold" })
                    @Html.EnumDropDownListFor(m => m.LessonType, "Select Type", new { @class = "form-select" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Price, new { @class = "form-label fw-bold" })
                    <div class="input-group">
                        <span class="input-group-text">£</span>
                        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                </div>

                <h5 class="fw-bold text-dark mb-0 mt-5 border-top pt-4">2. Scheduling & Location</h5>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.BlockStartDate, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.BlockStartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.DayOfWeek, new { @class = "form-label fw-bold" })
                    @Html.EnumDropDownListFor(m => m.DayOfWeek, "Select Day", new { @class = "form-select" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.StartTime, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.StartTime, new { @class = "form-control", type = "time" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.DurationInMinutes, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.DurationInMinutes, new { @class = "form-control", type = "number" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Capacity, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control", type = "number", min = "1", max = "6" })
                    @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "text-danger small fw-bold" })
                    <div class="form-text text-success small">
                        <i class="bi bi-info-circle"></i> Available places will be automatically recalculated.
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Venue</label>
                    @Html.DropDownList("VenueId", null, "Select Venue", new { @class = "form-select", required = "required" })
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">Assigned Instructor</label>
                    @Html.DropDownList("UserId", null, "TBC (Instructor Not Yet Assigned)", new { @class = "form-select" })
                </div>
            </div>

            <hr class="my-5" />

            <div class="text-end">
                <button type="submit" class="btn btn-primary btn-lg fw-bold px-5 shadow-sm">Save Changes</button>
            </div>
        }
    </div>
</div>