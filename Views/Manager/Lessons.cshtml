@model SwimmingSchool_Implementation.Models.LessonManagementViewModel

@{
    ViewBag.Title = "Lesson Management";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Lesson Management</h2>
        <a href="@Url.Action("CreateLesson", "Manager")" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-plus-lg"></i> Create New Lesson
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["ErrorMessage"]</div>
    }

    <ul class="nav nav-tabs mb-4" id="lessonTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab">
                Active & Upcoming Classes
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-muted" id="past-tab" data-bs-toggle="tab" data-bs-target="#past" type="button" role="tab">
                Past Classes (Archived)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="lessonTabsContent">

        <div class="tab-pane fade show active" id="active" role="tabpanel">
            <div class="table-responsive bg-white rounded shadow-sm border">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Class / Level</th>
                            <th>Schedule</th>
                            <th>Venue</th>
                            <th>Instructor</th>
                            <th>Capacity</th>
                            <th>Price</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ActiveLessons.Any())
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">No active lessons scheduled.</td></tr>
                        }
                        @foreach (var item in Model.ActiveLessons)
                        {
                            <tr>
                                <td class="fw-bold">@item.Title <br /><span class="badge bg-info text-dark small">@item.AgeGroup</span></td>
                                <td>
                                    <div class="text-dark">@item.DayOfWeek at @item.StartTime.ToString(@"hh\:mm")</div>
                                    <div class="text-muted small">Starts: @item.BlockStartDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td>@item.Venue.Name</td>
                                <td>@(item.Teacher != null ? item.Teacher.FirstName + " " + item.Teacher.SecondName : "TBC")</td>
                                <td>
                                    <span class="badge @(item.AvailablePlaces == 0 ? "bg-danger" : "bg-success")">
                                        @item.AvailablePlaces / @item.Capacity left
                                    </span>
                                </td>
                                <td>£@item.Price</td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("EditLesson", new { id = item.Id })" class="btn btn-sm btn-outline-secondary me-2">Edit</a>

                                    @using (Html.BeginForm("DeleteLesson", "Manager", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to delete this lesson?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="past" role="tabpanel">
            <div class="table-responsive bg-light rounded shadow-sm border opacity-75">
                <table class="table align-middle mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>Class / Level</th>
                            <th>Schedule</th>
                            <th>Venue</th>
                            <th>Instructor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.PastLessons.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">No past lessons found.</td></tr>
                        }
                        @foreach (var item in Model.PastLessons)
                        {
                            <tr>
                                <td class="fw-bold text-muted">@item.Title</td>
                                <td class="text-muted">
                                    <div>@item.DayOfWeek at @item.StartTime.ToString(@"hh\:mm")</div>
                                    <div class="small">Started: @item.BlockStartDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td class="text-muted">@item.Venue.Name</td>
                                <td class="text-muted">@(item.Teacher != null ? item.Teacher.FirstName + " " + item.Teacher.SecondName : "TBC")</td>
                                <td><span class="badge bg-secondary">Archived</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>