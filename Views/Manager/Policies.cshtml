@model IEnumerable<SwimmingSchool_Implementation.Models.Policy>

@{
    ViewBag.Title = "Manage Policies";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="text-primary fw-bold mb-0">School Policies & Waivers</h2>
            <p class="text-muted small mb-0">Manage terms, conditions, and waivers presented during booking.</p>
        </div>
        <a href="@Url.Action("CreatePolicy", "Manager")" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-plus-lg"></i> Add New Policy
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 25%;">Policy Title</th>
                            <th style="width: 45%;">Description</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-center py-5 text-muted">No policies have been added yet.</td></tr>
                        }

                        @foreach (var policy in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@policy.Title</td>
                                <td>
                                    <span class="text-muted small">
                                        @(policy.Description.Length > 100 ? policy.Description.Substring(0, 100) + "..." : policy.Description)
                                    </span>
                                </td>
                                <td>
                                    @if (policy.IsRequired)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-circle-fill me-1"></i> Mandatory</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Optional / Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("EditPolicy", new { id = policy.Id })" class="btn btn-sm btn-outline-primary px-3 me-1">Edit</a>

                                    @using (Html.BeginForm("DeletePolicy", "Manager", new { id = policy.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Are you sure you want to permanently delete this policy?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>