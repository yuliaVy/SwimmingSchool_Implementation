@model SwimmingSchool_Implementation.Models.Venue

@{ ViewBag.Title = "Edit Venue"; }

<div class="container py-5">
    <div class="mx-auto bg-white p-4 rounded shadow border" style="max-width: 800px;">

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h3 class="text-primary fw-bold mb-0">Edit Venue</h3>
            <a href="@Url.Action("Venues", "Manager")" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>

        @using (Html.BeginForm("EditVenue", "Manager", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.VenueId)
            @Html.HiddenFor(m => m.ImageName)

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row g-3">
                <div class="col-12 mb-3 bg-light p-3 rounded border">
                    <label class="form-label fw-bold small">Venue Photo</label>

                    @if (!string.IsNullOrEmpty(Model.ImageName))
                    {
                        <div class="mb-3 d-flex align-items-center gap-3">
                            <img src="~/Content/Images/@Model.ImageName" alt="Current Photo" class="rounded shadow-sm" style="width: 120px; height: 80px; object-fit: cover;" />
                            <span class="text-muted small">Current photo</span>
                        </div>
                    }

                    <input type="file" name="ImageUpload" class="form-control form-control-sm" accept="image/*" />
                    <small class="text-muted mt-1 d-block" style="font-size: 0.75rem;">Upload a new image to replace the current one. Leave blank to keep existing.</small>
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold small" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Address, new { @class = "form-label fw-bold small" })
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.PoolInfo, new { @class = "form-label fw-bold small" })
                    @Html.TextAreaFor(m => m.PoolInfo, new { @class = "form-control", rows = 3 })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Amenities, new { @class = "form-label fw-bold small" })
                    @Html.TextAreaFor(m => m.Amenities, new { @class = "form-control", rows = 3 })
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Save Changes</button>
            </div>
        }
    </div>
</div>