@model SwimmingSchool_Implementation.Models.EditTeacherViewModel

@{
    ViewBag.Title = "Edit Teacher Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="text-primary fw-bold mb-0">Edit Instructor Profile</h3>
                <a href="@Url.Action("Teachers", "Manager")" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    @using (Html.BeginForm("EditTeacher", "Manager", FormMethod.Post, new { enctype = "multipart/form-data", role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(m => m.Id)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm p-2 mb-4" })

                        <div class="col-12 mt-3 mb-4 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small">Profile Picture</label>

                            @if (!string.IsNullOrEmpty(Model.CurrentProfileImage))
                            {
                                <div class="mb-2 d-flex align-items-center gap-3">
                                    <img src="~/Content/Images/@Model.CurrentProfileImage" alt="Current Profile" class="rounded-circle shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                    <span class="text-muted small">Current picture</span>
                                </div>
                            }

                            <input type="file" name="ProfileImageUpload" class="form-control form-control-sm" accept="image/*" />
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Upload a new image to replace the current one. Leave blank to keep existing.</small>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-bold small" })
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.SecondName, new { @class = "form-label fw-bold small" })
                                @Html.TextBoxFor(m => m.SecondName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.SecondName, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-bold small" })
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", type = "tel" })
                                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-md-6">
                                @Html.LabelFor(m => m.TeacherPreference, new { @class = "form-label fw-bold small" })
                                @Html.EnumDropDownListFor(m => m.TeacherPreference, "Select Preference", new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.TeacherPreference, "", new { @class = "text-danger small" })
                            </div>

                            <div class="col-12 mt-4">
                                @Html.LabelFor(m => m.Bio, new { @class = "form-label fw-bold small" })
                                @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4, placeholder = "Add notes about their swimming background..." })
                                @Html.ValidationMessageFor(m => m.Bio, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-12 mt-4">
                            <label class="form-label fw-bold small border-bottom pb-2 mb-3 d-block">Assigned Teaching Venues</label>
                            <div class="row g-2 bg-light p-3 rounded border">
                                @if (Model.AvailableVenues != null && Model.AvailableVenues.Any())
                                {
                                    foreach (var venue in Model.AvailableVenues)
                                    {
                                        <div class="col-md-6 col-lg-4">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       name="SelectedVenueIds"
                                                       value="@venue.VenueId"
                                                       id="venue_@venue.VenueId"
                                                       @(venue.IsSelected ? "checked" : "") />
                                                <label class="form-check-label ms-1" for="venue_@venue.VenueId">
                                                    @venue.VenueName
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small">No venues found in the system. Please add venues first.</div>
                                }
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-top text-end">
                            <a href="@Url.Action("Teachers", "Manager")" class="btn btn-light me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary fw-bold px-4">Save Changes</button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}