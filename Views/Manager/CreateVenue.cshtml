@model SwimmingSchool_Implementation.Models.Venue

@{ ViewBag.Title = "Add New Venue"; }

<div class="container py-5">
    <div class="mx-auto bg-white p-4 rounded shadow border" style="max-width: 800px;">

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h3 class="text-primary fw-bold mb-0">Add New Venue</h3>
            <a href="@Url.Action("Venues", "Manager")" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>

        @using (Html.BeginForm("CreateVenue", "Manager", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row g-3">
                <div class="col-12 mb-2">
                    <label class="form-label fw-bold small">Venue Photo</label>
                    <input type="file" name="ImageUpload" class="form-control" accept="image/*" />
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold small" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "e.g. City Central Pool" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Address, new { @class = "form-label fw-bold small" })
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "123 Main St, City" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.PoolInfo, new { @class = "form-label fw-bold small" })
                    @Html.TextAreaFor(m => m.PoolInfo, new { @class = "form-control", rows = 3, placeholder = "e.g. 25m length, heated to 29°C" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.Amenities, new { @class = "form-label fw-bold small" })
                    @Html.TextAreaFor(m => m.Amenities, new { @class = "form-control", rows = 3, placeholder = "e.g. Free parking, spectator seating, lockers" })
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Save Venue</button>
            </div>
        }
    </div>
</div>