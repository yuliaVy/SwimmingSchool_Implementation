@model SwimmingSchool_Implementation.Models.Policy

@{ ViewBag.Title = "Add New Policy"; }

<div class="container py-5">
    <div class="mx-auto bg-white p-4 rounded shadow border" style="max-width: 800px;">

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <h3 class="text-primary fw-bold mb-0">Add New Policy</h3>
            <a href="@Url.Action("Policies", "Manager")" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>

        @using (Html.BeginForm("CreatePolicy", "Manager", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row g-4">
                <div class="col-12">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label fw-bold small" })
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Liability Waiver, Photography Policy" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold small" })
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 6, placeholder = "Enter the full legal text or description here..." })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                </div>

                <div class="col-12 bg-light p-3 rounded border">
                    <div class="form-check form-switch">
                        @Html.CheckBoxFor(m => m.IsRequired, new { @class = "form-check-input fs-5" })
                        <label class="form-check-label fw-bold ms-2 pt-1" for="IsRequired">Mandatory Policy</label>
                    </div>
                    <div class="form-text mt-2">
                        If checked, parents <strong class="text-danger">must</strong> agree to this policy before the system will allow them to complete a booking.
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top text-end">
                <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Save Policy</button>
            </div>
        }
    </div>
</div>