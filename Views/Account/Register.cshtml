@model SwimmingSchool_Implementation.Models.RegisterViewModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<div class="container py-5">
    <div class="mx-auto bg-white p-4 rounded shadow border" style="max-width: 1100px;">

        <div class="text-center mb-5">
            <img src="~/Content/Images/logo.png" style="max-width:180px;" />
            <h1 class="mt-3 text-primary fw-bold">Registration</h1>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "payment-form", onsubmit = "return validateBookingAge()" }))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(false, "Please correct the following errors:", new { @class = "alert alert-danger" })
            }

            <h4 class="text-primary border-bottom pb-2 mb-4">1. Account Holder Details</h4>
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", id = "AccFirstName" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.SecondName, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.SecondName, new { @class = "form-control", id = "AccSecondName" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
                </div>
                @if (!User.Identity.IsAuthenticated)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Password *</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Confirm Password *</label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-end border-bottom pb-2 mb-4">
                <h4 class="text-primary m-0">2. Swimmers</h4>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="addStudent()">+ Add Another Swimmer</button>
            </div>

            <div id="students-container">
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    <div class="student-block bg-light p-4 rounded mb-4 border position-relative" data-index="@i">

                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 btn-remove"
                                style="@(i == 0 ? "display:none;" : "")" onclick="removeStudent(this)">
                            Remove
                        </button>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold m-0">Swimmer <span class="student-number">@(i + 1)</span></h5>
                            @if (i == 0)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="isAdultCheckbox" onchange="copyAdultDetails(this)">
                                    <label class="form-check-label text-muted" for="isAdultCheckbox">I am the student (Adult)</label>
                                </div>
                            }
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">First Name</label>
                                @Html.TextBoxFor(m => m.Students[i].FirstName, new { @class = "form-control s-first" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Last Name</label>
                                @Html.TextBoxFor(m => m.Students[i].LastName, new { @class = "form-control s-last" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Gender</label>
                                @Html.DropDownListFor(m => m.Students[i].Gender, new SelectList(new[] { "Female", "Male", "Other" }), "Select", new { @class = "form-select" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Date of Birth</label>
                                @Html.TextBoxFor(m => m.Students[i].BirthDate, "{0:yyyy-MM-dd}", new
                                {
                                    @class = "form-control dob-input-field",
                                    type = "date",
                                    @Value = Model.Students[i].BirthDate == default(DateTime) ? "" : Model.Students[i].BirthDate.ToString("yyyy-MM-dd")
                                })
                            </div>
                        </div>
                        <div class="row g-3 mb-4 mt-2 border-top pt-3">
                            <h6 class="text-primary fw-bold mb-0">Additional Information (Optional)</h6>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Swim Experience</label>
                                @Html.DropDownListFor(m => m.Students[i].SwimExperience, new SelectList(new[] { "Complete Beginner", "Some Experience", "Intermediate", "Advanced" }), "Select Experience", new { @class = "form-select" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Aquatic Goals</label>
                                @Html.TextBoxFor(m => m.Students[i].AquaticGoals, new { @class = "form-control", placeholder = "e.g., Water safety, stroke improvement" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Medical Conditions</label>
                                @Html.TextBoxFor(m => m.Students[i].MedicalConditions, new { @class = "form-control", placeholder = "Leave blank if none" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Allergies</label>
                                @Html.TextBoxFor(m => m.Students[i].Allergies, new { @class = "form-control", placeholder = "Leave blank if none" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Medications</label>
                                @Html.TextBoxFor(m => m.Students[i].Medications, new { @class = "form-control", placeholder = "Leave blank if none" })
                            </div>
                        </div>

                        <div class="p-3 bg-white border rounded mb-3">
                            <label class="form-label small fw-bold text-primary">Selected Class for this Swimmer</label>
                            <div class="d-flex align-items-center gap-3">
                                @Html.HiddenFor(m => m.Students[i].SelectedLessonId, new { @class = "lesson-id-input" })
                                <input type="hidden" class="lesson-price-input" value="@Model.Students[i].LessonPrice" />
                                <input type="hidden" class="lesson-type-input" value="@Model.Students[i].SelectedLessonType" />

                                <input type="text" readonly class="form-control-plaintext fw-bold lesson-title-display" value="@Model.Students[i].SelectedLessonTitle" placeholder="No class selected" />
                                <button type="button" class="btn btn-warning btn-sm text-nowrap" onclick="openLessonModal(@i)">Choose/Change Class</button>
                            </div>
                        </div>

                        <div class="p-3 bg-white border rounded">
                            <label class="form-label small fw-bold text-primary">Policies & Agreements</label>
                            @if (ViewBag.Policies != null)
                            {
                                foreach (var policy in ViewBag.Policies)
                                {
                                    <div class="form-check mt-2">
                                        <input type="checkbox" name="Students[@i].AcceptedPolicies" value="@policy.Id" class="form-check-input" required />
                                        <label class="form-check-label small text-muted">I agree to the @policy.Title</label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            <h4 class="mb-3" style="color: #00A8E8;">3. Payment Options</h4>
            <div class="p-4 mb-4 rounded border bg-light">

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input fs-5" type="checkbox" id="PayDepositOnly" name="PayDepositOnly" value="true" onchange="calculateTotal()">
                    <input type="hidden" name="PayDepositOnly" value="false" />
                    <label class="form-check-label fs-5 ms-2 pt-1" for="PayDepositOnly">
                        <strong>Pay 20% Deposit Only</strong> <br />
                        <span class="text-muted small">Pay a 20% deposit today to secure your spots. The remaining balance is due on the day of your first lesson.</span>
                    </label>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <h4 class="fw-bold m-0">Total to pay today:</h4>
                    <h3 class="fw-bold m-0 text-success" id="displayTotal">£0.00</h3>
                </div>
            </div>

            <hr class="my-5" />

            <div class="row g-3">
                <div class="col-md-6">
                    <button type="submit" name="PaymentMethod" value="Stripe" class="btn btn-dark btn-lg w-100 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2">
                        <span>Pay with Card (Stripe)</span>
                    </button>
                </div>
                <div class="col-md-6">
                    <button type="submit" name="PaymentMethod" value="PayPal" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm d-flex justify-content-center align-items-center gap-2" style="color: #003087;">
                        <span>Pay with PayPal</span>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="lessonModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Select a Class</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body border-bottom bg-light">
                <div class="row g-2">
                    <div class="col-md-6">
                        <select id="modalVenueFilter" class="form-select" onchange="filterModalLessons()">
                            <option value="">All Venues</option>
                            @if (ViewBag.Venues != null)
                            {
                                foreach (var venue in ViewBag.Venues)
                                {
                                    <option value="@venue.Name">@venue.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <select id="modalAudienceFilter" class="form-select" onchange="filterModalLessons()">
                            <option value="">All Ages (Adults & Kids)</option>
                            <option value="Kids">Kids Classes Only</option>
                            <option value="Adult">Adult Classes Only</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-body p-0">
                <div class="list-group list-group-flush" id="modalLessonList">
                    @if (ViewBag.AllLessons != null)
                    {
                        foreach (var lesson in ViewBag.AllLessons)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action p-3 lesson-modal-item"
                                    data-venue="@lesson.Venue.Name"
                                    data-audience="@lesson.LessonType"
                                    data-lesson-id="@lesson.Id"
                                    data-capacity="@lesson.AvailablePlaces"
                                    onclick="selectLessonForStudent(@lesson.Id, '@lesson.Title (@lesson.DayOfWeek)', @lesson.Price, '@lesson.LessonType')">

                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1 fw-bold text-dark">
                                            @lesson.Title
                                            <span class="badge bg-secondary ms-2 text-wrap" style="font-size:0.75rem;">@lesson.Venue.Name</span>
                                        </h5>
                                        <div class="text-muted small mt-2">
                                            <span class="fw-bold text-primary">@lesson.DayOfWeek</span> |
                                            <span class="fw-bold text-dark">@lesson.StartTime.ToString(@"hh\:mm")</span> |
                                            <span>@lesson.LessonType</span> |
                                            <span>£@lesson.Price</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="mb-1 text-muted small fw-bold">Openings: <span class="openings-display">@lesson.AvailablePlaces</span></div>
                                        <span class="badge bg-success rounded-pill px-3 py-2 select-btn-badge">Select</span>
                                    </div>
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.onload = calculateTotal;
        let currentEditingStudentIndex = 0;
        const lessonModal = new bootstrap.Modal(document.getElementById('lessonModal'));

        // "I am the student" check
        function copyAdultDetails(checkbox) {
            const firstInput = document.querySelector('.student-block[data-index="0"] .s-first');
            const lastInput = document.querySelector('.student-block[data-index="0"] .s-last');

            if (checkbox.checked) {
                firstInput.value = document.getElementById('AccFirstName').value;
                lastInput.value = document.getElementById('AccSecondName').value;
            } else {
                firstInput.value = "";
                lastInput.value = "";
            }
        }

        // ----- MODAL FILTERING LOGIC -----
        function filterModalLessons() {
            const venueName = document.getElementById('modalVenueFilter').value;
            const audience = document.getElementById('modalAudienceFilter').value;
            const items = document.querySelectorAll('.lesson-modal-item');

            items.forEach(item => {
                const itemVenueName = item.getAttribute('data-venue');
                const itemAudience = item.getAttribute('data-audience');

                // Check if the dropdown is blank ("All") OR if the Names match exactly
                const matchVenue = (venueName === "" || itemVenueName === venueName);
                const matchAudience = (audience === "" || itemAudience === audience || itemAudience === "Both");

                if (matchVenue && matchAudience) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // ---- THE CALCULATOR
        function calculateTotal() {
            let subtotal = 0;

            // Find all hidden price inputs across all active student blocks
            const priceInputs = document.querySelectorAll('.lesson-price-input');

            priceInputs.forEach(input => {
                const price = parseFloat(input.value);
                // If it's a valid number greater than 0, add it to our subtotal
                if (!isNaN(price) && price > 0) {
                    subtotal += price;
                }
            });

            // Check if deposit only is selected
            const isDeposit = document.getElementById('PayDepositOnly').checked;
            const finalTotal = isDeposit ? (subtotal * 0.20) : subtotal;

            // Update the big green text
            const display = document.getElementById('displayTotal');
            if (display) {
                display.innerText = `£${finalTotal.toFixed(2)}`;
            }
        }

        // ----- CAPACITY TRACKING LOGIC -----
        function updateModalCapacities() {
            // 1. Find out how many times each lesson is selected by OTHER students in this form
            const selectedInputs = document.querySelectorAll('.lesson-id-input');
            const selectedCounts = {};

            selectedInputs.forEach(input => {
                const studentBlock = input.closest('.student-block');
                const studentIndex = parseInt(studentBlock.getAttribute('data-index'));

                // Don't count the student we are currently editing (so they don't block their own seat)
                if (studentIndex !== currentEditingStudentIndex) {
                    const lessonId = input.value;
                    if (lessonId) {
                        selectedCounts[lessonId] = (selectedCounts[lessonId] || 0) + 1;
                    }
                }
            });

            // 2. Update the UI for every class in the modal
            const items = document.querySelectorAll('.lesson-modal-item');
            items.forEach(item => {
                const lessonId = item.getAttribute('data-lesson-id');
                const dbCapacity = parseInt(item.getAttribute('data-capacity'));

                // Available = DB Capacity - Taken By Siblings
                const takenBySiblings = selectedCounts[lessonId] || 0;
                const availableLocally = dbCapacity - takenBySiblings;

                const badge = item.querySelector('.select-btn-badge');
                const openingsDisplay = item.querySelector('.openings-display');

                openingsDisplay.innerText = availableLocally;

                if (availableLocally <= 0) {
                    // Disable the button
                    item.classList.add('disabled', 'bg-light');
                    item.style.pointerEvents = 'none';
                    badge.className = 'badge bg-danger rounded-pill px-3 py-2 select-btn-badge';
                    badge.innerText = 'Full';
                } else {
                    // Enable the button
                    item.classList.remove('disabled', 'bg-light');
                    item.style.pointerEvents = 'auto';
                    badge.className = 'badge bg-success rounded-pill px-3 py-2 select-btn-badge';
                    badge.innerText = 'Select';
                }
            });
        }

        // Open Modal to pick lesson
        function openLessonModal(studentIndex) {
            currentEditingStudentIndex = studentIndex;

            // Run capacity checks right before the modal opens
            updateModalCapacities();

            lessonModal.show();
        }

        // Triggered when user clicks a lesson inside the modal
        // ADDED: audienceType parameter
        function selectLessonForStudent(lessonId, lessonTitle, lessonPrice, audienceType) {
            const studentBlock = document.querySelector(`.student-block[data-index="${currentEditingStudentIndex}"]`);

            studentBlock.querySelector('.lesson-id-input').value = lessonId;
            studentBlock.querySelector('.lesson-title-display').value = lessonTitle;
            studentBlock.querySelector('.lesson-price-input').value = lessonPrice;

            // ADDED: Save the audience type into this specific student's hidden field
            studentBlock.querySelector('.lesson-type-input').value = audienceType;

            lessonModal.hide();

            calculateTotal();
        }

        // Add Dynamic Student
        function addStudent() {
            const container = document.getElementById('students-container');
            const blocks = container.querySelectorAll('.student-block');
            const newIndex = blocks.length;

            const newBlock = blocks[0].cloneNode(true);
            newBlock.setAttribute('data-index', newIndex);

            newBlock.querySelector('.student-number').innerText = newIndex + 1;

            newBlock.querySelector('.btn-remove').style.display = 'block';
            const adultCheck = newBlock.querySelector('.form-check');
            if (adultCheck) adultCheck.remove();

            const inputs = newBlock.querySelectorAll('input, select');
            inputs.forEach(input => {
                // Clear all text inputs, dates, and hidden fields
                if (input.type === "text" || input.type === "date" || input.type === "hidden") {
                    input.value = "";
                }
                // Uncheck checkboxes
                if (input.type === "checkbox") {
                    input.checked = false;
                }
                // Reset dropdowns (like Gender and Swim Experience) back to default
                if (input.tagName.toLowerCase() === "select") {
                    input.selectedIndex = 0;
                }

                if (input.classList.contains('lesson-price-input')) {
                    input.value = "0";
                }
                // Update names and IDs for MVC binding
                if (input.name) input.name = input.name.replace(/\[0\]/g, `[${newIndex}]`);
                if (input.id) input.id = input.id.replace(/_0__/g, `_${newIndex}__`);
            });

            const chooseBtn = newBlock.querySelector('.btn-warning');
            chooseBtn.setAttribute('onclick', `openLessonModal(${newIndex})`);

            container.appendChild(newBlock);
            // Recalculate the total
            calculateTotal();
        }

        // Remove Dynamic Student
        function removeStudent(button) {
            const block = button.closest('.student-block');
            block.remove();

            const blocks = document.querySelectorAll('.student-block');
            blocks.forEach((b, index) => {
                b.setAttribute('data-index', index);
                b.querySelector('.student-number').innerText = index + 1;

                const chooseBtn = b.querySelector('.btn-warning');
                if (chooseBtn) chooseBtn.setAttribute('onclick', `openLessonModal(${index})`);

                const inputs = b.querySelectorAll('input, select');
                inputs.forEach(input => {
                    if (input.name) input.name = input.name.replace(/\[\d+\]/g, `[${index}]`);
                    if (input.id) input.id = input.id.replace(/_\d+__/g, `_${index}__`);
                });
            });
            // Recalculate the total so the price drops when a student is removed!
            calculateTotal();
        }

        // ADDED: The complete validation function mapping through all student blocks
        function validateBookingAge() {
            const blocks = document.querySelectorAll('.student-block');

            for (let i = 0; i < blocks.length; i++) {
                const dobElement = blocks[i].querySelector('.dob-input-field');
                const lessonTypeElement = blocks[i].querySelector('.lesson-type-input');

                // If they haven't filled out a date or selected a class, skip our custom check.
                // Standard ASP.NET [Required] validation will catch it instead.
                if (!dobElement || !dobElement.value || !lessonTypeElement || !lessonTypeElement.value) {
                    continue;
                }

                const dob = new Date(dobElement.value);
                const today = new Date();

                // 1. Future Date Check
                if (dob > today) {
                    alert(`Swimmer ${i + 1}: Date of birth cannot be in the future.`);
                    return false;
                }

                // Calculate accurate age
                let age = today.getFullYear() - dob.getFullYear();
                const monthDifference = today.getMonth() - dob.getMonth();
                if (monthDifference < 0 || (monthDifference === 0 && today.getDate() < dob.getDate())) {
                    age--;
                }

                const lessonType = lessonTypeElement.value.toLowerCase();
                const isKidsClass = lessonType.includes("kid") || lessonType.includes("child");
                const isAdultClass = lessonType.includes("adult");

                // 2. Kids Rule Check (Between 3 and 17)
                if (isKidsClass && (age < 3 || age >= 18)) {
                    alert(`Swimmer ${i + 1} is ${age} years old. Kids classes require students to be between 3 and 17 years old.`);
                    return false;
                }

                // 3. Adults Rule Check (18+)
                if (isAdultClass && age < 18) {
                    alert(`Swimmer ${i + 1} is ${age} years old. Adult classes require students to be at least 18 years old.`);
                    return false;
                }
            }

            return true; // Validated successfully
        }

    </script>
}
}