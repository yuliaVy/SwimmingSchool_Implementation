@model SwimmingSchool_Implementation.Models.TimetableIndexViewModel

@{
    ViewBag.Title = "Master Timetable";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-0">Daily Timetable</h2>
            <p class="text-muted">
                @if (User.IsInRole("Manager"))
                {<span>Viewing all scheduled school sessions.</span> }
                else
                { <span>Viewing your assigned teaching sessions.</span>}
            </p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            @using (Html.BeginForm("Index", "Timetable", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Select Date (Max 90 Days)</label>
                    <input type="date" name="selectedDate" class="form-control"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.AddDays(90).ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Filter by Venue</label>
                    @Html.DropDownListFor(m => m.SelectedVenueId, Model.Venues, "All Venues", new { @class = "form-select" })
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary fw-bold w-100">Update Timetable</button>
                </div>
            }
        </div>
    </div>

    @if (!Model.Sessions.Any())
    {
        <div class="alert alert-secondary text-center py-5 shadow-sm">
            <h5 class="fw-bold text-muted mb-1">No Classes Scheduled</h5>
            <p class="mb-0 text-muted">There are no swimming lessons matching your criteria for this date.</p>
        </div>
    }
    else
    {
        <div class="accordion shadow-sm" id="timetableAccordion">
            @for (int i = 0; i < Model.Sessions.Count; i++)
            {
                var session = Model.Sessions[i];
                var headerId = "heading" + i;
                var collapseId = "collapse" + i;

                <div class="accordion-item border-0 border-bottom">
                    <h2 class="accordion-header" id="@headerId">
                        <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <div class="d-flex w-100 justify-content-between align-items-center me-3">
                                <div>
                                    <span class="badge bg-primary fs-6 me-2">@session.StartTime</span>
                                    <strong class="text-dark fs-5">@session.LessonType</strong>
                                </div>
                                <div class="text-end text-muted small">
                                    <div class="fw-bold"><i class="bi bi-geo-alt-fill"></i> @session.VenueName</div>
                                    @if (User.IsInRole("Manager"))
                                    {
                                        <div><i class="bi bi-person-badge"></i> @session.TeacherName</div>
                                    }
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headerId" data-bs-parent="#timetableAccordion">
                        <div class="accordion-body bg-light p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Swimmer Name</th>
                                        <th>Age</th>
                                        <th>Level / Experience</th>
                                        <th>Health Status</th>
                                        <th>Status</th>
                                        <th class="text-end pe-4">Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!session.Students.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-4">No students booked yet.</td></tr>
                                    }

                                    @foreach (var student in session.Students)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@student.FullName</td>
                                            <td>@student.Age</td>
                                            <td>
                                                <span class="text-muted small">
                                                    @(string.IsNullOrWhiteSpace(student.SwimExperience) ? "Not provided" : student.SwimExperience)
                                                </span>
                                            </td>
                                            <td>
                                                @if (student.HasMedicalFlag)
                                                {
                                                    <span class="badge bg-danger"><i class="bi bi-heart-pulse-fill me-1"></i> Medical Alert</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Cleared</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-1">

                                                    @if (User.IsInRole("Manager"))
                                                    {
                                                        using (Html.BeginForm("UpdateSessionStatus", "Timetable", FormMethod.Post, new { @class = "d-inline" }))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="sessionId" value="@student.SessionId" />
                                                            <input type="hidden" name="filterDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <input type="hidden" name="selectedVenueId" value="@Model.SelectedVenueId" />

                                                            <select name="newStatus" class="form-select form-select-sm border border-secondary shadow-sm" onchange="this.form.submit()" style="min-width: 120px;">
                                                                @foreach (var status in Enum.GetValues(typeof(SwimmingSchool_Implementation.Models.SessionStatus)))
                                                                {
                                                                    <option value="@status" @(status.ToString() == student.SessionStatus ? "selected" : "")>
                                                                        @status
                                                                    </option>
                                                                }
                                                            </select>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark border">@student.SessionStatus</span>
                                                    }

                                                    <span class="badge bg-light text-primary border mt-1">Payment: @student.PaymentStatus</span>
                                                </div>
                                            </td>
                                            <td class="text-end pe-4">
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modal-@student.UniqueModalId">
                                                    View Profile
                                                </button>
                                            </td>
                                        </tr>
                                        <div class="modal fade" id="modal-@student.UniqueModalId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header bg-light">
                                                        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-badge text-primary me-2"></i> @student.FullName's Profile</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">

                                                        <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Aquatic Profile</h6>
                                                        <div class="row mb-4">
                                                            <div class="col-6">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Age</small>
                                                                <span>@student.Age years old</span>
                                                            </div>
                                                            <div class="col-6">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Experience</small>
                                                                <span>@(string.IsNullOrWhiteSpace(student.SwimExperience) ? "None" : student.SwimExperience)</span>
                                                            </div>
                                                            <div class="col-12 mt-3">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Aquatic Goals</small>
                                                                <p class="mb-0 bg-light p-2 rounded border">@(string.IsNullOrWhiteSpace(student.AquaticGoals) ? "No specific goals provided." : student.AquaticGoals)</p>
                                                            </div>
                                                        </div>

                                                        <h6 class="fw-bold text-danger border-bottom border-danger pb-2 mb-3"><i class="bi bi-shield-fill-exclamation me-1"></i> Health & Safety</h6>
                                                        <div class="row g-3">
                                                            <div class="col-12">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Medical Conditions</small>
                                                                <div class="@(string.IsNullOrWhiteSpace(student.MedicalConditions) ? "text-muted" : "text-danger fw-bold")">
                                                                    @(string.IsNullOrWhiteSpace(student.MedicalConditions) ? "None reported." : student.MedicalConditions)
                                                                </div>
                                                            </div>
                                                            <div class="col-12">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Allergies</small>
                                                                <div class="@(string.IsNullOrWhiteSpace(student.Allergies) ? "text-muted" : "text-danger fw-bold")">
                                                                    @(string.IsNullOrWhiteSpace(student.Allergies) ? "None reported." : student.Allergies)
                                                                </div>
                                                            </div>
                                                            <div class="col-12">
                                                                <small class="text-muted text-uppercase fw-bold d-block">Medications</small>
                                                                <div>@(string.IsNullOrWhiteSpace(student.Medications) ? "None reported." : student.Medications)</div>
                                                            </div>
                                                        </div>

                                                        @if (User.IsInRole("Manager"))
                                                        {
                                                            <h6 class="fw-bold text-success border-bottom border-success pb-2 mb-3 mt-4"><i class="bi bi-wallet-fill me-1"></i> Account Holder & Billing Info</h6>
                                                            <div class="row g-3 bg-light p-2 rounded border">
                                                                <div class="col-md-6">
                                                                    <small class="text-muted text-uppercase fw-bold d-block">Registered Parent</small>
                                                                    <div class="fw-bold">@student.ParentName</div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <small class="text-muted text-uppercase fw-bold d-block">Contact Info</small>
                                                                    <div><a href="mailto:@student.ParentEmail" class="text-decoration-none">@student.ParentEmail</a></div>
                                                                    <div>@student.ParentPhone</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                            
                                
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Initialize Bootstrap tooltips so the medical notes pop up when hovering over the red badge
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}