@model SwimmingSchool_Implementation.Models.IndexViewModel

@{
    ViewBag.Title = "Manage Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<div class="container py-5">
    <h2 class="mb-4 text-primary fw-bold">Dashboard</h2>

    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success!</strong> @ViewBag.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 fw-bold">Security Settings</h5>
                </div>
                <div class="card-body p-4">

                    <div class="mb-4 border-bottom pb-3">
                        <h6 class="fw-bold text-muted text-uppercase small">Password</h6>
                        @if (Model.HasPassword)
                        {
                            <a href="@Url.Action("ChangePassword", "Manage")" class="btn btn-outline-dark w-100">Change Password</a>
                        }
                        else
                        {
                            <a href="@Url.Action("SetPassword", "Manage")" class="btn btn-primary w-100">Create Password</a>
                        }
                    </div>

                    <div class="mb-4 border-bottom pb-3">
                        <h6 class="fw-bold text-muted text-uppercase small">External Logins</h6>
                        <p class="mb-2">Connected Accounts: <span class="badge bg-secondary">@Model.Logins.Count</span></p>
                        <a href="@Url.Action("ManageLogins", "Manage")" class="btn btn-outline-dark w-100">Manage Logins</a>
                    </div>

                    <div>
                        <h6 class="fw-bold text-muted text-uppercase small">Two-Factor Authentication</h6>
                        @if (Model.TwoFactor)
                        {
                            using (Html.BeginForm("DisableTwoFactorAuthentication", "Manage", FormMethod.Post, new { role = "form" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100">Disable 2FA</button>
                            }
                        }
                        else
                        {
                            using (Html.BeginForm("EnableTwoFactorAuthentication", "Manage", FormMethod.Post, new { role = "form" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">Enable 2FA</button>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="m-0 fw-bold">Profile Information</h5>
                </div>
                <div class="card-body p-4">

                    @using (Html.BeginForm("UpdateProfile", "Manage", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <h6 class="text-primary fw-bold mb-3">Basic Details</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">First Name</label>
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Last Name</label>
                                @Html.TextBoxFor(m => m.SecondName, new { @class = "form-control" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Email Address</label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Phone Number</label>
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Date of Birth</label>
                                @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                        </div>

                        <h6 class="text-primary fw-bold border-top pt-4 mb-3">Address</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label small fw-bold">Address Line 1</label>
                                @Html.TextBoxFor(m => m.AddressLine1, new { @class = "form-control" })
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Address Line 2 (Optional)</label>
                                @Html.TextBoxFor(m => m.AddressLine2, new { @class = "form-control" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">City</label>
                                @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Postcode</label>
                                @Html.TextBoxFor(m => m.Postcode, new { @class = "form-control" })
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Country</label>
                                @Html.TextBoxFor(m => m.Country, new { @class = "form-control" })
                            </div>
                        </div>

                        if (Model.IsTeacher)
                        {
                            <h6 class="text-primary fw-bold border-top pt-4 mb-3">Teacher Profile</h6>
                            <div class="bg-light p-3 rounded border mb-4">

                                <div class="mb-3 d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                                    {
                                        <img src="~/Content/Images/@Model.ProfileImage" class="rounded-circle object-fit-cover shadow-sm" width="80" height="80" alt="Profile" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary rounded-circle d-flex justify-content-center align-items-center text-white shadow-sm" style="width:80px; height:80px;">No Photo</div>
                                    }
                                    <div class="flex-grow-1">
                                        <label class="form-label small fw-bold">Update Profile Photo</label>
                                        <input type="file" name="profileUpload" class="form-control" accept="image/*" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Teacher Bio</label>
                                    @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4, placeholder = "Share your swimming background with your students..." })
                                </div>

                                <div>
                                    <label class="form-label small fw-bold">Teaching Preferences</label>
                                    @Html.EnumDropDownListFor(m => m.TeacherPreference, "Select a teaching preference...", new { @class = "form-select" })
                                </div>
                            </div>
                        }

                        <div class="text-end border-top pt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm">Save Profile</button>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>