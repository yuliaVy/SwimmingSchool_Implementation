@model SwimmingSchool_Implementation.Models.BookingPageViewModel
@using SwimmingSchool_Implementation.Models

@{
    ViewBag.Title = "Book Lessons";

    var orderedDays = new[]
    {
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    };
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

    .selection-card {
        background: rgba(255,255,255,0.9);
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
    }

    .venue-btn,
    .lesson-type-btn {
        width: 100%;
        padding: 25px;
        border: none;
        border-radius: 12px;
        background: #214b9c;
        color: white;
        font-size: 1.2rem;
        font-weight: bold;
        transition: 0.3s;
    }

        .venue-btn:hover,
        .lesson-type-btn:hover {
            background: #2f9738;
            transform: scale(1.02);
        }

    .venue-image {
        width: 100%;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .info-box {
        background: rgba(255,255,255,0.85);
        border-radius: 12px;
        padding: 25px;
        height: 100%;
    }

    .pricing-line {
        margin-bottom: 2px;
        font-size: 0.95rem;
    }

    .teacher-box {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        align-items: center;
    }

        .teacher-box img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
        }

    .schedule-grid {
        display: flex;
        gap: 12px;
        overflow-x: auto;
    }

    .day-column {
        min-width: 220px;
    }

    .day-header {
        background: #214b9c;
        color: white;
        text-align: center;
        padding: 15px;
        border-radius: 10px;
        font-weight: bold;
        margin-bottom: 10px;
    }
    .lesson-card {
        position: relative;
        background-color: #d8c0bd;
        color: white;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 12px;
        transition: all 0.3s ease;
        overflow: hidden;
        min-height: 140px;
        cursor: pointer;
    }

        .lesson-card.available {
            background-color: #2f9738;
        }

        .lesson-card:hover {
            transform: scale(1.03);
            z-index: 20;
        }

    .lesson-extra {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
    }

    .lesson-card.available:hover .lesson-extra {
        max-height: 300px;
        margin-top: 10px;
    }

    .register-btn {
        width: 100%;
        border: none;
        padding: 10px;
        border-radius: 8px;
        background: #f2b233;
        color: white;
        font-weight: bold;
    }

    @@media(max-width:992px) {

        .schedule-grid {
            flex-direction: column;
        }

        .day-column {
            width: 100%;
        }

        .teacher-box {
            flex-direction: column;
            text-align: center;
        }
    }

    /* Enhanced Pricing Styles */
    .pricing-tier-card {
        background-color: #ffffff;
        border: 1px solid #EBEBEB;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .pricing-tier-card:hover {
            transform: translateY(-3px);
            border-color: #00A8E8; /* Aqua hover effect */
        }

    .tier-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #F4F9F9;
        padding-bottom: 15px;
        margin-bottom: 15px;
    }

        .tier-header h4 {
            margin: 0;
            color: #1A365D; /* Navy */
            font-weight: 700;
            font-size: 1.3rem;
        }

    .tier-price {
        font-size: 1.6rem;
        font-weight: 700;
        color: #00A8E8; /* Aqua */
    }

        .tier-price span {
            font-size: 0.9rem;
            color: #777;
            font-weight: 400;
        }

    .tier-features {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .tier-features li {
            padding: 6px 0;
            color: #555;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }

            /* Custom Checkmark for the list */
            .tier-features li::before {
                content: '✓';
                color: #FF6F59; /* Coral accent */
                font-weight: bold;
                font-size: 1.1rem;
                margin-right: 12px;
            }
</style>

<div class="container-fluid">

    <!-- STEP 1 -->
    <div class="selection-card">

        <h2 class="fw-bold text-center mb-4">
            1. Choose Your Venue
        </h2>

        <div class="row g-4">

            @foreach (var venue in Model.Venues)
            {
                <div class="col-md-4">

                    <button class="venue-btn"
                            onclick="location.href='@Url.Action("Index", "Booking", new { venueId = venue.VenueId })'">

                        @venue.Name

                    </button>

                </div>
            }

        </div>

    </div>

    <!-- STEP 2 -->
    @if (Model.SelectedVenueId.HasValue)
    {
        <div class="selection-card">

            <h2 class="fw-bold text-center mb-4">
                2. Who Are The Lessons For?
            </h2>

            <div class="row g-4">

                <div class="col-md-6">

                    <button class="lesson-type-btn"
                            onclick="location.href='@Url.Action("Index", "Booking",
                            new {
                                venueId = Model.SelectedVenueId,
                                lessonType = LessonType.Kids
                            })'">

                        Kids Lessons

                    </button>

                </div>

                <div class="col-md-6">

                    <button class="lesson-type-btn"
                            onclick="location.href='@Url.Action("Index", "Booking",
                            new {
                                venueId = Model.SelectedVenueId,
                                lessonType = LessonType.Adult
                            })'">

                        Adult Lessons

                    </button>

                </div>

            </div>

        </div>
    }

    <!-- TIMETABLE -->
    @if (Model.SelectedLessonType.HasValue)
    {
        <div class="selection-card">

            <h2 class="fw-bold mb-4 text-center">
                Available Lessons
            </h2>

            <div class="schedule-grid">

                @foreach (var day in orderedDays)
                {
                    var dayLessons = Model.Lessons
                        .Where(l => l.DayOfWeek == day)
                        .OrderBy(l => l.StartTime)
                        .ToList();

                    <div class="day-column">

                        <div class="day-header">
                            @day
                        </div>

                        @if (!dayLessons.Any())
                        {
                            <div class="lesson-card">
                                No lessons available
                            </div>
                        }

                        @foreach (var lesson in dayLessons)
                        {
                            bool available = lesson.AvailablePlaces > 0;

                            <div class="lesson-card @(available ? "available" : "")">

                                <h5 class="text-center fw-bold">
                                    @lesson.Title
                                </h5>

                                <h3 class="text-center mt-3">
                                    @DateTime.Today.Add(lesson.StartTime).ToString("HH:mm")
                                </h3>

                                <p class="text-center">
                                    £@lesson.Price
                                </p>

                                <p>
                                    <strong>Teacher:</strong>
                                    @lesson.Teacher.FirstName
                                </p>

                                <p>
                                    <strong>Spaces:</strong>
                                    @lesson.AvailablePlaces
                                </p>

                                @if (available)
                                {
                                    <div class="lesson-extra">

                                        <p><strong>Ages:</strong> @lesson.AgeGroup</p>
                                        <p>@lesson.DurationInMinutes mins</p>
                                        <p><strong>Openings:</strong> @lesson.AvailablePlaces</p>

                                        <button class="register-btn"
                                                onclick="location.href='@Url.Action("Register", "Account", new { lessonId = lesson.Id })'">
                                            REGISTER
                                        </button>

                                    </div>
                                }
                                else
                                {
                                    <div class="text-center fw-bold mt-3">
                                        Fully Booked
                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

        </div>
    }


    <!-- VENUE INFO -->
    @if (Model.SelectedVenue != null)
    {
        <div class="row">
            <div class="col-lg-6">
                <div class="info-box" style="background: transparent; border: none; box-shadow: none; padding: 0;">

                    <h2 class="fw-bold mb-4" style="color: #1A365D;">Pricing Guide</h2>

                    <div class="pricing-tier-card">
                        <div class="tier-header">
                            <h4>Private Lessons</h4>
                            <div class="tier-price">£100<span>/mo</span></div>
                        </div>
                        <ul class="tier-features">
                            <li>30 mins per week</li>
                            <li>Exclusive 1:1 instructor ratio</li>
                            <li>4 lessons per month</li>
                        </ul>
                    </div>

                    <div class="pricing-tier-card">
                        <div class="tier-header">
                            <h4>Semi-Private</h4>
                            <div class="tier-price">£75<span>/mo</span></div>
                        </div>
                        <ul class="tier-features">
                            <li>30 mins per week</li>
                            <li>Shared 2:1 instructor ratio</li>
                            <li>4 lessons per month</li>
                        </ul>
                    </div>

                    <div class="pricing-tier-card">
                        <div class="tier-header">
                            <h4>Group Lessons</h4>
                            <div class="tier-price">£60<span>/mo</span></div>
                        </div>
                        <ul class="tier-features">
                            <li>30 mins per week</li>
                            <li>Up to 6:1 instructor ratio</li>
                            <li>4 lessons per month</li>
                        </ul>
                    </div>

                </div>
            </div>

            <div class="col-lg-6">
                <div class="info-box">
                    <img src="~/Content/Images/@Model.SelectedVenue.ImageName" class="venue-image" />

                    <h3 class="fw-bold mt-3">@Model.SelectedVenue.Name</h3>
                    <p>@Model.SelectedVenue.Address</p>
                    <hr />

                    <h5>Pool Information</h5>
                    <p>@Model.SelectedVenue.PoolInfo</p>

                    <h5>Amenities</h5>
                    <p>@Model.SelectedVenue.Amenities</p>
                    <hr />

                    <h5 class="mb-4">Instructors Working Here</h5>

                    @foreach (var teacher in Model.Teachers)
                    {
                        <div class="teacher-box">
                            <img src="~/Content/Images/@teacher.ProfileImage" />
                            <div>
                                <h5>@teacher.FirstName</h5>
                                <p>@teacher.Bio</p>
                                <a href="@Url.Action("Team", "Home")">Read More</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

</div>